# OpenAI-compatible API credentials. The same provider may serve every role.
AGNES_API_KEY=replace-with-your-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Model under test. Use a different model from the evaluation roles for reported runs.
NCPBENCH_NARRATOR_API_KEY_ENV=AGNES_API_KEY
NCPBENCH_NARRATOR_BASE_URL=${AGNES_BASE_URL}
NCPBENCH_NARRATOR_MODEL=replace-with-model-under-test

# Evaluation roles. The player and auditor may share this model.
# For a quick smoke test, all three roles may temporarily use the same model.
NCPBENCH_PLAYER_API_KEY_ENV=AGNES_API_KEY
NCPBENCH_PLAYER_BASE_URL=${AGNES_BASE_URL}
NCPBENCH_PLAYER_MODEL=agnes-2.5-flash

NCPBENCH_AUDITOR_API_KEY_ENV=AGNES_API_KEY
NCPBENCH_AUDITOR_BASE_URL=${AGNES_BASE_URL}
NCPBENCH_AUDITOR_MODEL=agnes-2.5-flash
